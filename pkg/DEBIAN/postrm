#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
  rm -f /etc/sudoers.d/displaymod /run/systemd/system/displaymod-view.service
  rm -f /usr/share/APPLaunch/applications/displaymod-bigterm.desktop
  rm -rf /run/displaymod
  systemctl daemon-reload 2>/dev/null || true
fi
[ "$1" = purge ] && rm -f /etc/displaymod.conf
exit 0
